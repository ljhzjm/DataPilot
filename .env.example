# Host ports. Change these if they conflict with local services.
FRONTEND_PORT=18080
BACKEND_PORT=18000
POSTGRES_PORT=25432
REDIS_PORT=26379

# Development database credentials.
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot_dev_password

# OpenAI-compatible model gateway. Keep the key in the ignored .env file.
LLM_PROVIDER_NAME=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_TASK_MODELS={"sql":"gpt-4o-mini","intent":"gpt-4o-mini"}
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_INCLUDE_USAGE_IN_STREAM=true
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0

# Chat runtime: preview | agent | disabled
CHAT_RUNTIME_MODE=agent
CHAT_HISTORY_CHAR_BUDGET=12000
AGENT_MAX_STEPS=10
AGENT_MAX_TOTAL_TOKENS=49152
AGENT_MAX_TOOL_CALLS_PER_STEP=3
AGENT_MAX_TOOL_BUDGET_RETRIES=1
AGENT_MAX_PARALLEL_TOOLS=3
AGENT_CONTEXT_CHAR_BUDGET=24000
AGENT_KEEP_RECENT_TOOL_RESULTS=6
AGENT_PARALLEL_TOOLS=true

# Dataset upload limits.
DATASET_MAX_UPLOAD_BYTES=20971520
DATASET_MAX_ROWS=500000
DATASET_MAX_COLUMNS=500
DATASET_RESTORE_ON_STARTUP=true

# Shared token used only between the backend and sandbox runner.
SANDBOX_RUNNER_TOKEN=datapilot-dev-sandbox-token
